        "liquid_jzVMyp": {
          "type": "liquid",
          "settings": {
            "liquid": "{% liquid\n  assign ld_tab_description = product.metafields.custom.tab_description\n  assign ld_tab_highlights = product.metafields.custom.tab_highlights.value\n  assign ld_tab_specifications = product.metafields.custom.tab_specifications.value\n  assign ld_tab_shipping = product.metafields.custom.tab_shipping\n  assign ld_tab_warranty = product.metafields.custom.tab_warranty\n%}\n\n{% capture ld_tabs_id %}ld-tabs-{{ product.id }}-{{ section.id }}-{{ block.id }}{% endcapture %}\n\n<div class=\"ld-product-tabs\" data-ld-product-tabs>\n\n  <div class=\"ld-product-tabs__nav\" role=\"tablist\" aria-label=\"Product information\">\n\n    <button\n      id=\"{{ ld_tabs_id }}-description-tab\"\n      class=\"ld-product-tabs__tab\"\n      type=\"button\"\n      role=\"tab\"\n      aria-selected=\"true\"\n      aria-controls=\"{{ ld_tabs_id }}-description\"\n      tabindex=\"0\"\n    >Description</button>\n\n    <button\n      id=\"{{ ld_tabs_id }}-specifications-tab\"\n      class=\"ld-product-tabs__tab\"\n      type=\"button\"\n      role=\"tab\"\n      aria-selected=\"false\"\n      aria-controls=\"{{ ld_tabs_id }}-specifications\"\n      tabindex=\"-1\"\n    >Specifications</button>\n\n    <button\n      id=\"{{ ld_tabs_id }}-shipping-tab\"\n      class=\"ld-product-tabs__tab\"\n      type=\"button\"\n      role=\"tab\"\n      aria-selected=\"false\"\n      aria-controls=\"{{ ld_tabs_id }}-shipping\"\n      tabindex=\"-1\"\n    >Shipping</button>\n\n    <button\n      id=\"{{ ld_tabs_id }}-warranty-tab\"\n      class=\"ld-product-tabs__tab\"\n      type=\"button\"\n      role=\"tab\"\n      aria-selected=\"false\"\n      aria-controls=\"{{ ld_tabs_id }}-warranty\"\n      tabindex=\"-1\"\n    >Warranty</button>\n\n  </div>\n\n  <!-- DESCRIPTION : TEXT ONLY -->\n  <section\n    id=\"{{ ld_tabs_id }}-description\"\n    class=\"ld-product-tabs__panel\"\n    role=\"tabpanel\"\n    aria-labelledby=\"{{ ld_tabs_id }}-description-tab\"\n    tabindex=\"0\"\n  >\n    <div class=\"ld-product-tabs__copy\">\n      {% if ld_tab_description != blank %}\n        <p>{{ ld_tab_description | metafield_text | escape }}</p>\n      {% elsif product.description != blank %}\n        {% assign ld_description_text = product.description | replace: '</p>', ' ' | replace: '</div>', ' ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '</li>', ' · ' | strip_html | strip %}\n        <p>{{ ld_description_text | escape_once }}</p>\n      {% else %}\n        <p>Discover the details of this piece.</p>\n      {% endif %}\n    </div>\n  </section>\n\n  <!-- SPECIFICATIONS -->\n  <section\n    id=\"{{ ld_tabs_id }}-specifications\"\n    class=\"ld-product-tabs__panel\"\n    role=\"tabpanel\"\n    aria-labelledby=\"{{ ld_tabs_id }}-specifications-tab\"\n    tabindex=\"0\"\n    hidden\n  >\n\n    {% if ld_tab_highlights != blank %}\n      <ul class=\"ld-product-tabs__highlights\">\n        {% for highlight in ld_tab_highlights limit: 15 %}\n          <li>{{ highlight | escape }}</li>\n        {% endfor %}\n      </ul>\n    {% endif %}\n\n    {% if ld_tab_specifications != blank %}\n      <dl class=\"ld-product-tabs__specifications\">\n        {% for item in ld_tab_specifications limit: 25 %}\n          {% if item.label != blank and item.value != blank %}\n            <div class=\"ld-product-tabs__spec-row\">\n              <dt>{{ item.label | escape }}</dt>\n              <dd>{{ item.value | escape }}</dd>\n            </div>\n          {% endif %}\n        {% endfor %}\n      </dl>\n    {% elsif ld_tab_highlights == blank %}\n      <p class=\"ld-product-tabs__empty\">\n        Product specifications will be available soon.\n      </p>\n    {% endif %}\n\n  </section>\n\n  <!-- SHIPPING -->\n  <section\n    id=\"{{ ld_tabs_id }}-shipping\"\n    class=\"ld-product-tabs__panel\"\n    role=\"tabpanel\"\n    aria-labelledby=\"{{ ld_tabs_id }}-shipping-tab\"\n    tabindex=\"0\"\n    hidden\n  >\n    <div class=\"ld-product-tabs__copy\">\n\n      {% if ld_tab_shipping != blank %}\n        {{ ld_tab_shipping | metafield_tag }}\n      {% else %}\n        <p>\n          <strong>Free U.S. shipping.</strong>\n          Estimated delivery within 5–7 days.\n          Every order is carefully packaged to protect\n          your purchase during transit.\n        </p>\n      {% endif %}\n\n    </div>\n  </section>\n\n  <!-- WARRANTY AND CARE -->\n  <section\n    id=\"{{ ld_tabs_id }}-warranty\"\n    class=\"ld-product-tabs__panel\"\n    role=\"tabpanel\"\n    aria-labelledby=\"{{ ld_tabs_id }}-warranty-tab\"\n    tabindex=\"0\"\n    hidden\n  >\n    <div class=\"ld-product-tabs__copy\">\n\n      {% if ld_tab_warranty != blank %}\n        {{ ld_tab_warranty | metafield_tag }}\n      {% else %}\n\n        <p>\n          <strong>Warranty coverage.</strong>\n          Your purchase is covered by a two-year\n          legal guarantee of conformity and statutory\n          protection against hidden defects.\n        </p>\n\n        <p>\n          If an item is defective or arrives damaged,\n          we will arrange an exchange or refund.\n          Please contact us and include photos\n          of the issue.\n        </p>\n\n        <p>\n          <strong>Care instructions.</strong>\n          Gently wipe with a soft, dry cloth.\n          Avoid household cleaning products\n          on lacquered surfaces and leather.\n        </p>\n\n      {% endif %}\n\n    </div>\n  </section>\n\n</div>\n\n<style>\n  .ld-product-tabs {\n    --ld-tabs-ink: #1C2A36;\n    --ld-tabs-muted: #5D6873;\n    --ld-tabs-faint: #949BA2;\n    --ld-tabs-rule: #E9DED3;\n\n    width: 100%;\n    margin: 14px 0 24px;\n    color: var(--ld-tabs-ink);\n    font-family: inherit;\n    box-sizing: border-box;\n  }\n\n  .ld-product-tabs *,\n  .ld-product-tabs *::before,\n  .ld-product-tabs *::after {\n    box-sizing: border-box;\n  }\n\n  .ld-product-tabs__nav {\n    display: flex;\n    align-items: stretch;\n    gap: clamp(22px, 4vw, 38px);\n    width: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    border-bottom: 1px solid var(--ld-tabs-rule);\n    scrollbar-width: none;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .ld-product-tabs__nav::-webkit-scrollbar {\n    display: none;\n  }\n\n  .ld-product-tabs__tab {\n    appearance: none;\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n\n    width: auto;\n    min-width: 0;\n    min-height: 40px;\n\n    margin: 0;\n    padding: 0 0 15px;\n\n    background: transparent !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n\n    color: var(--ld-tabs-faint);\n    font-family: inherit;\n    font-size: 11px;\n    font-weight: 600;\n    line-height: 1.3;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n    white-space: nowrap;\n\n    cursor: pointer;\n    transition: color .15s ease;\n  }\n\n  .ld-product-tabs__tab::before,\n  .ld-product-tabs__tab::after {\n    box-shadow: none !important;\n  }\n\n  .ld-product-tabs__tab::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    bottom: -1px;\n    left: 0;\n    height: 1px;\n    background: transparent;\n  }\n\n  .ld-product-tabs__tab[aria-selected=\"true\"] {\n    color: var(--ld-tabs-ink);\n  }\n\n  .ld-product-tabs__tab[aria-selected=\"true\"]::after {\n    background: #CDB9A5;\n  }\n\n  .ld-product-tabs__tab:focus-visible {\n    outline: 2px solid var(--ld-tabs-ink);\n    outline-offset: -3px;\n  }\n\n  .ld-product-tabs__tab:hover {\n    color: var(--ld-tabs-ink);\n  }\n\n  .ld-product-tabs__panel {\n    padding: 21px 0 0;\n  }\n\n  .ld-product-tabs__panel[hidden] {\n    display: none !important;\n  }\n\n  .ld-product-tabs__copy,\n  .ld-product-tabs__highlights,\n  .ld-product-tabs__empty {\n    margin: 0;\n    color: var(--ld-tabs-muted);\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 1.85;\n  }\n\n  .ld-product-tabs__copy p {\n    margin: 0 0 12px;\n  }\n\n  .ld-product-tabs__copy p:last-child {\n    margin-bottom: 0;\n  }\n\n  .ld-product-tabs__copy strong,\n  .ld-product-tabs__copy b {\n    color: var(--ld-tabs-ink);\n    font-weight: 650;\n  }\n\n  .ld-product-tabs__copy a {\n    color: var(--ld-tabs-ink);\n    text-decoration: underline;\n  }\n\n  .ld-product-tabs__highlights {\n    list-style: none;\n    padding: 0;\n    margin: 0 0 18px;\n  }\n\n  .ld-product-tabs__highlights li {\n    display: flex;\n    align-items: baseline;\n    gap: 12px;\n    margin: 0 0 6px;\n    padding: 0;\n  }\n\n  .ld-product-tabs__highlights li::before {\n    content: \"—\";\n    color: var(--ld-tabs-faint);\n    flex: 0 0 auto;\n  }\n\n  .ld-product-tabs__specifications {\n    margin: 0;\n    padding: 0;\n  }\n\n  .ld-product-tabs__spec-row {\n    display: grid;\n    grid-template-columns: minmax(110px, 36%) minmax(0, 1fr);\n    align-items: center;\n    gap: 18px;\n\n    min-height: 54px;\n    padding: 15px 0;\n    border-bottom: 1px solid var(--ld-tabs-rule);\n  }\n\n  .ld-product-tabs__spec-row dt,\n  .ld-product-tabs__spec-row dd {\n    margin: 0;\n    font-family: inherit;\n    font-size: 13px;\n    line-height: 1.55;\n    overflow-wrap: anywhere;\n  }\n\n  .ld-product-tabs__spec-row dt {\n    color: var(--ld-tabs-ink);\n    font-weight: 550;\n  }\n\n  .ld-product-tabs__spec-row dd {\n    color: var(--ld-tabs-muted);\n    text-align: right;\n  }\n\n  /* MOBILE */\n\n  @media screen and (max-width: 600px) {\n\n    .ld-product-tabs {\n      margin: 12px 0 20px;\n    }\n\n    .ld-product-tabs__nav {\n      gap: 22px;\n    }\n\n    .ld-product-tabs__tab {\n      min-height: 36px;\n      padding-bottom: 12px;\n      font-size: 10px;\n      letter-spacing: .1em;\n    }\n\n    .ld-product-tabs__panel {\n      padding-top: 18px;\n    }\n\n    .ld-product-tabs__copy,\n    .ld-product-tabs__highlights,\n    .ld-product-tabs__empty {\n      font-size: 13px;\n      line-height: 1.75;\n    }\n\n    .ld-product-tabs__spec-row {\n      grid-template-columns: minmax(86px, 34%) minmax(0, 1fr);\n      min-height: 48px;\n      gap: 12px;\n      padding: 12px 0;\n    }\n\n    .ld-product-tabs__spec-row dt,\n    .ld-product-tabs__spec-row dd {\n      font-size: 12px;\n    }\n\n  }\n\n  /* SMALL MOBILE */\n\n  @media screen and (max-width: 360px) {\n\n    .ld-product-tabs__nav {\n      gap: 17px;\n    }\n\n    .ld-product-tabs__tab {\n      font-size: 9px;\n      letter-spacing: .06em;\n    }\n\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ld-product-tabs__tab {\n      transition: none;\n    }\n  }\n\n</style>\n\n<script>\n  (function () {\n\n    function initProductTabs(root) {\n\n      if (root.dataset.ldTabsReady === 'true') return;\n      root.dataset.ldTabsReady = 'true';\n\n      var tabs = Array.from(\n        root.querySelectorAll('[role=\"tab\"]')\n      );\n\n      var panels = Array.from(\n        root.querySelectorAll('[role=\"tabpanel\"]')\n      );\n\n      function activate(tab, moveFocus) {\n\n        tabs.forEach(function (item) {\n          var active = item === tab;\n          item.setAttribute(\n            'aria-selected',\n            active ? 'true' : 'false'\n          );\n          item.tabIndex = active ? 0 : -1;\n        });\n\n        panels.forEach(function (panel) {\n          panel.hidden =\n            panel.id !== tab.getAttribute('aria-controls');\n        });\n\n        if (moveFocus) tab.focus();\n      }\n\n      tabs.forEach(function (tab, index) {\n\n        tab.addEventListener('click', function () {\n          activate(tab, false);\n        });\n\n        tab.addEventListener('keydown', function (event) {\n\n          var next = index;\n\n          if (event.key === 'ArrowRight') {\n            next = (index + 1) % tabs.length;\n          } else if (event.key === 'ArrowLeft') {\n            next = (index - 1 + tabs.length) % tabs.length;\n          } else if (event.key === 'Home') {\n            next = 0;\n          } else if (event.key === 'End') {\n            next = tabs.length - 1;\n          } else {\n            return;\n          }\n\n          event.preventDefault();\n          activate(tabs[next], true);\n\n        });\n\n      });\n\n    }\n\n    document\n      .querySelectorAll('[data-ld-product-tabs]')\n      .forEach(initProductTabs);\n\n    document.addEventListener(\n      'shopify:section:load',\n      function (event) {\n        event.target\n          .querySelectorAll('[data-ld-product-tabs]')\n          .forEach(initProductTabs);\n      }\n    );\n\n  })();\n</script>"
