   color: #2BA874;\n    font-size: 18px;\n    font-weight: 400;\n    line-height: 1;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  .ld-customer-review__quote {\n    max-width: 780px;\n    margin: 0 0 7px;\n    padding: 0;\n    border: 0;\n    color: #222B33;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.45;\n    letter-spacing: 0;\n  }\n\n  .ld-customer-review__person {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 1px;\n    line-height: 1.35;\n  }\n\n  .ld-customer-review__person strong {\n    color: #111;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .ld-customer-review__person span {\n    color: #5D6873;\n    font-family: inherit;\n    font-size: 12px;\n    font-weight: 400;\n  }\n\n  @media screen and (max-width: 749px) {\n    .ld-customer-review {\n      grid-template-columns: 90px minmax(0, 1fr);\n      align-items: start;\n      gap: 14px;\n      margin: 16px 0;\n      padding: 3px 0;\n    }\n\n    .ld-customer-review__photo {\n      width: 90px;\n      height: 90px;\n    }\n\n    .ld-customer-review__stars {\n      margin-bottom: 7px;\n      font-size: 17px;\n      letter-spacing: .4px;\n    }\n\n    .ld-customer-review__quote {\n      margin-bottom: 8px;\n      font-size: 13px;\n      line-height: 1.5;\n    }\n\n    .ld-customer-review__person strong {\n      font-size: 13px;\n    }\n\n    .ld-customer-review__person span {\n      font-size: 12px;\n    }\n  }\n\n  @media screen and (max-width: 359px) {\n    .ld-customer-review {\n      grid-template-columns: 76px minmax(0, 1fr);\n      gap: 12px;\n    }\n\n    .ld-customer-review__photo {\n      width: 76px;\n      height: 76px;\n    }\n\n    .ld-customer-review__quote {\n      font-size: 12px;\n    }\n  }\n</style>"
