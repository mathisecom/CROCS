<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Luxurious+Script&display=swap" rel="stylesheet">

<section class="favs-section" data-favs-section="{{ section.id }}" style="
  --favs-bg: {{ section.settings.background_color }};
  --favs-heading: {{ section.settings.heading_color }};
  --favs-muted: {{ section.settings.text_color }};
  --favs-line: {{ section.settings.line_color }};
  --favs-card-bg: {{ section.settings.card_background }};
  --favs-max: {{ section.settings.max_width }}px;
  --favs-gap: {{ section.settings.card_gap }}px;
  --favs-top: {{ section.settings.padding_top }}px;
  --favs-bottom: {{ section.settings.padding_bottom }}px;
  --favs-side: {{ section.settings.padding_side }}px;
  --favs-title-size: {{ section.settings.title_size }}px;
  --favs-script-size: {{ section.settings.script_size }}px;
  --favs-body-size: {{ section.settings.body_size }}px;
  --favs-ratio: {{ section.settings.product_ratio }};
  --favs-overlay: {{ section.settings.overlay_color }};
  --favs-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  --favs-promo-color: {{ section.settings.promo_text_color }};
  --favs-mobile-card: {{ section.settings.mobile_card_width }}%;
  --favs-mobile-title: {{ section.settings.mobile_title_size }}px;
  --favs-mobile-script: {{ section.settings.mobile_script_size }}px;
  --favs-mobile-side: {{ section.settings.mobile_side }}px;
  --favs-mobile-top: {{ section.settings.mobile_top }}px;
  --favs-mobile-bottom: {{ section.settings.mobile_bottom }}px;
">
  <div class="favs-container">
    <div class="favs-header">
      <div class="favs-header-copy">
        <h2 class="favs-heading">
          <span>{{ section.settings.title | escape }}</span>
          {% if section.settings.script_title != blank %}
            <span class="favs-script">{{ section.settings.script_title | escape }}</span>
          {% endif %}
        </h2>
        {% if section.settings.description != blank %}
          <div class="favs-description">{{ section.settings.description }}</div>
        {% endif %}
      </div>
      {% if section.settings.view_all_label != blank %}
        <a class="favs-view-all" href="{{ section.settings.view_all_url | default: '/collections/all' }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="favs-layout">
      <a class="favs-promo" href="{{ section.settings.promo_url | default: '/collections/all' }}">
        {% if section.settings.promo_image != blank %}
          {{ section.settings.promo_image | image_url: width: 1400 | image_tag: class: 'favs-promo-image', loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(max-width: 749px) 100vw, 28vw' }}
        {% else %}
          <div class="favs-promo-placeholder" aria-hidden="true"></div>
        {% endif %}
        <span class="favs-promo-overlay" aria-hidden="true"></span>
        <span class="favs-promo-content">
          <span class="favs-promo-heading">
            {{ section.settings.promo_title | escape }}
            {% if section.settings.promo_script != blank %}
              <span class="favs-script">{{ section.settings.promo_script | escape }}</span>
            {% endif %}
          </span>
          {% if section.settings.promo_cta != blank %}
            <span class="favs-promo-cta">
              {{ section.settings.promo_cta | escape }}
              <span aria-hidden="true">↗</span>
            </span>
          {% endif %}
        </span>
      </a>

      <div class="favs-carousel" data-favs-carousel>
        <div class="favs-track" data-favs-track tabindex="0" aria-label="Produits favoris à faire défiler">
          {% for block in section.blocks %}
            {% if block.type == 'product_card' %}
              {% assign selected_product = block.settings.product %}
              {% assign card_image = block.settings.image %}
              {% if card_image == blank and selected_product != blank %}
                {% assign card_image = selected_product.featured_image %}
              {% endif %}
              {% assign card_name = block.settings.title %}
              {% if card_name == blank and selected_product != blank %}
                {% assign card_name = selected_product.title %}
              {% endif %}
              {% assign card_link = block.settings.link %}
              {% if card_link == blank and selected_product != blank %}
                {% assign card_link = selected_product.url %}
              {% endif %}
              <div class="favs-card" data-favs-card {{ block.shopify_attributes }}>
                <div class="favs-product-image">
                  {% if card_image != blank %}
                    {{ card_image | image_url: width: 900 | image_tag: class: 'favs-image', loading: 'lazy', widths: '250, 400, 600, 800, 900', sizes: '(max-width: 749px) 65vw, 24vw' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'favs-image favs-placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="favs-product-information">
                  {% if card_name != blank %}<div class="favs-product-title">{{ card_name | escape }}</div>{% endif %}
                  {% if block.settings.subtitle != blank %}<div class="favs-product-subtitle">{{ block.settings.subtitle | escape }}</div>{% endif %}
                  {% if section.settings.show_prices %}
                    {% if block.settings.price_text != blank %}
                      <div class="favs-product-price">{{ block.settings.price_text | escape }}</div>
                    {% elsif selected_product != blank %}
                      <div class="favs-product-price">{{ section.settings.price_prefix | escape }} {{ selected_product.price_min | money }}</div>
                    {% endif %}
                  {% endif %}
                </div>
                {% if card_link != blank %}
                  <a class="favs-product-link" href="{{ card_link }}" aria-label="Découvrir {{ card_name | escape }}"></a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="favs-controls">
          <div class="favs-progress" aria-hidden="true">
            <span class="favs-progress-fill" data-favs-progress></span>
          </div>
          <div class="favs-arrows">
            <button class="favs-arrow" type="button" data-favs-prev aria-label="Voir les produits précédents">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
            </button>
            <button class="favs-arrow" type="button" data-favs-next aria-label="Voir les produits suivants">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .favs-section { background: var(--favs-bg); padding: var(--favs-top) var(--favs-side) var(--favs-bottom); color: var(--favs-heading); width: 100%; box-sizing: border-box; }
  .favs-section *, .favs-section *::before, .favs-section *::after { box-sizing: border-box; }
  .favs-container { width: 100%; max-width: var(--favs-max); margin: 0 auto; }
  .favs-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 25px; }
  .favs-header-copy { min-width: 0; }
  .favs-heading { font-family: var(--font-heading-family, var(--font-body-family, inherit)); font-size: var(--favs-title-size); font-weight: 400; letter-spacing: -.035em; line-height: 1.2; color: var(--favs-heading); margin: 0; }
  .favs-script { font-family: 'Luxurious Script', cursive; font-size: var(--favs-script-size); font-weight: 400; font-style: italic; letter-spacing: 0; line-height: 1; }
  .favs-description { font-family: var(--font-body-family, inherit); font-size: var(--favs-body-size); font-weight: 400; line-height: 1.65; color: var(--favs-muted); margin-top: 11px; }
  .favs-description p { margin: 0; }
  .favs-view-all { font-family: var(--font-body-family, inherit); color: var(--favs-heading); font-size: 12px; text-decoration: underline; text-underline-offset: 5px; white-space: nowrap; flex-shrink: 0; margin-bottom: 3px; }
  .favs-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3.05fr); gap: var(--favs-gap); align-items: start; }
  .favs-promo { position: relative; display: block; overflow: hidden; isolation: isolate; aspect-ratio: .68; border-radius: 5px; color: var(--favs-promo-color); background: var(--favs-card-bg); text-decoration: none; }
  .favs-promo-image, .favs-promo-placeholder { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .favs-promo-placeholder { background: linear-gradient(145deg, #7d6049, #342c29 65%, #1b2227); }
  .favs-promo-image { transition: transform .5s ease; }
  .favs-promo:hover .favs-promo-image { transform: scale(1.035); }
  .favs-promo-overlay { position: absolute; inset: 0; background: var(--favs-overlay); opacity: var(--favs-overlay-opacity); }
  .favs-promo-content { position: absolute; z-index: 1; bottom: 25px; left: 24px; right: 22px; display: flex; flex-direction: column; align-items: flex-start; }
  .favs-promo-heading { font-family: var(--font-heading-family, var(--font-body-family, inherit)); font-size: 25px; line-height: 1.18; font-weight: 400; max-width: 230px; }
  .favs-promo-heading .favs-script { font-size: 32px; white-space: nowrap; }
  .favs-promo-cta { font-family: var(--font-body-family, inherit); display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; max-width: 210px; font-size: 10px; font-weight: 600; letter-spacing: .18em; line-height: 1.5; border-bottom: 1px solid currentColor; padding: 16px 0 9px; }
  .favs-promo-cta span { font-size: 16px; font-weight: 400; }
  .favs-carousel { min-width: 0; }
  .favs-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--favs-gap) - var(--favs-gap)) / 3); gap: var(--favs-gap); overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; }
  .favs-track::-webkit-scrollbar { display: none; }
  .favs-card { position: relative; min-width: 0; scroll-snap-align: start; }
  .favs-product-image { width: 100%; aspect-ratio: var(--favs-ratio); background: var(--favs-card-bg); overflow: hidden; border-radius: 5px; }
  .favs-image { display: block; height: 100%; width: 100%; object-fit: cover; transition: transform .4s ease; }
  .favs-card:hover .favs-image { transform: scale(1.025); }
  .favs-placeholder-svg { color: #a5a09a; }
  .favs-product-information { padding: 11px 1px 0; font-family: var(--font-body-family, inherit); line-height: 1.45; }
  .favs-product-title { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--favs-heading); }
  .favs-product-subtitle { font-size: 11px; color: var(--favs-muted); margin-top: 3px; }
  .favs-product-price { font-size: 12px; font-weight: 400; color: var(--favs-heading); margin-top: 3px; }
  .favs-product-link { position: absolute; inset: 0; z-index: 2; }
  .favs-product-link:focus-visible, .favs-promo:focus-visible, .favs-view-all:focus-visible, .favs-arrow:focus-visible, .favs-track:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .favs-controls { display: flex; align-items: center; gap: 20px; margin-top: 27px; }
  .favs-progress { position: relative; height: 1px; background: var(--favs-line); flex: 1; overflow: hidden; }
  .favs-progress-fill { display: block; height: 100%; width: 34%; background: var(--favs-heading); transition: width .15s ease; }
  .favs-arrows { display: flex; align-items: center; gap: 8px; }
  .favs-arrow { width: 41px; height: 30px; border: 1px solid var(--favs-line); background: transparent; border-radius: 5px; color: var(--favs-heading); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  .favs-arrow svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .favs-arrow:disabled { opacity: .3; cursor: default; }
  @media screen and (max-width: 989px) {
    .favs-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr); }
    .favs-track { grid-auto-columns: calc((100% - var(--favs-gap)) / 2); }
  }
  @media screen and (max-width: 749px) {
    .favs-section { padding: var(--favs-mobile-top) var(--favs-mobile-side) var(--favs-mobile-bottom); }
    .favs-header { flex-direction: column; align-items: center; text-align: center; gap: 16px; margin-bottom: 32px; }
    .favs-heading { font-size: var(--favs-mobile-title); }
    .favs-heading .favs-script { font-size: var(--favs-mobile-script); white-space: nowrap; }
    .favs-description { margin-top: 12px; }
    .favs-layout { display: flex; flex-direction: column; gap: 24px; }
    .favs-promo { aspect-ratio: .8; width: 100%; }
    .favs-promo-content { bottom: 24px; left: 24px; right: 22px; }
    .favs-promo-heading { font-size: 27px; }
    .favs-promo-heading .favs-script { font-size: 34px; }
    .favs-carousel { width: 100%; }
    .favs-track { grid-auto-columns: var(--favs-mobile-card); gap: 12px; }
    .favs-controls { margin-top: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .favs-track { scroll-behavior: auto; }
    .favs-image, .favs-promo-image, .favs-progress-fill { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  function initFavouritesCarousel(root) {
    root.querySelectorAll('[data-favs-carousel]').forEach(function(carousel) {
      if (carousel.dataset.ready === 'true') return;
      carousel.dataset.ready = 'true';
      var track = carousel.querySelector('[data-favs-track]');
      var prev = carousel.querySelector('[data-favs-prev]');
      var next = carousel.querySelector('[data-favs-next]');
      var bar = carousel.querySelector('[data-favs-progress]');
      if (!track || !prev || !next || !bar) return;
      function update() {
        var max = Math.max(0, track.scrollWidth - track.clientWidth);
        var progress = max ? track.scrollLeft / max : 1;
        var visible = track.scrollWidth ? track.clientWidth / track.scrollWidth : 1;
        bar.style.width = Math.min(100, 100 * (visible + (1 - visible) * progress)) + '%';
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max - 2;
      }
      function move(direction) {
        var item = track.querySelector('[data-favs-card]');
        if (!item) return;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        track.scrollBy({ left: direction * (item.getBoundingClientRect().width + gap), behavior: 'smooth' });
      }
      prev.addEventListener('click', function() { move(-1); });
      next.addEventListener('click', function() { move(1); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  }
  initFavouritesCarousel(document);
  document.addEventListener('shopify:section:load', function(event) { initFavouritesCarousel(event.target); });
{% endjavascript %}

{% schema %}
{
  "name": "Favoris clients - Slider",
  "tag": "section",
  "class": "section-favoris-clients",
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les favoris de nos" },
    { "type": "text", "id": "script_title", "label": "Mot en Luxurious Script", "default": "clients." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Les pièces que nos clients choisissent le plus souvent, et qu'ils recommandent ensuite à leurs proches.</p>" },
    { "type": "text", "id": "view_all_label", "label": "Texte du lien", "default": "Tout voir" },
    { "type": "url", "id": "view_all_url", "label": "Lien Tout voir" },
    { "type": "header", "content": "Carte collection" },
    { "type": "image_picker", "id": "promo_image", "label": "Image collection" },
    { "type": "text", "id": "promo_title", "label": "Texte sur l'image", "default": "Découvrir toute la" },
    { "type": "text", "id": "promo_script", "label": "Mot manuscrit", "default": "collection" },
    { "type": "text", "id": "promo_cta", "label": "Lien dans l'image", "default": "EXPLORER LA COLLECTION" },
    { "type": "url", "id": "promo_url", "label": "Destination collection" },
    { "type": "color", "id": "overlay_color", "label": "Couleur de l'ombre", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Intensité de l'ombre", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "promo_text_color", "label": "Texte de l'image", "default": "#FFFFFF" },
    { "type": "header", "content": "Produits" },
    { "type": "checkbox", "id": "show_prices", "label": "Afficher les prix", "default": true },
    { "type": "text", "id": "price_prefix", "label": "Avant le prix", "default": "À partir de" },
    { "type": "select", "id": "product_ratio", "label": "Format des images produit", "options": [
      { "value": "0.8", "label": "Portrait 4:5" },
      { "value": "1", "label": "Carré" },
      { "value": "0.7", "label": "Portrait allongé" }
    ], "default": "0.8" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#F3EEE8" },
    { "type": "color", "id": "heading_color", "label": "Titres et prix", "default": "#192534" },
    { "type": "color", "id": "text_color", "label": "Descriptions", "default": "#6E7681" },
    { "type": "color", "id": "line_color", "label": "Ligne du carrousel", "default": "#D3CDC5" },
    { "type": "color", "id": "card_background", "label": "Fond des images sans photo", "default": "#E6DFD5" },
    { "type": "header", "content": "Dimensions ordinateur" },
    { "type": "range", "id": "max_width", "label": "Largeur maximale", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1120 },
    { "type": "range", "id": "card_gap", "label": "Écart entre les cartes", "min": 4, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_side", "label": "Marge latérale", "min": 10, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "title_size", "label": "Taille du titre", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "script_size", "label": "Taille manuscrite", "min": 30, "max": 70, "step": 1, "unit": "px", "default": 47 },
    { "type": "range", "id": "body_size", "label": "Taille du paragraphe", "min": 11, "max": 19, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Dimensions mobile" },
    { "type": "range", "id": "mobile_title_size", "label": "Taille titre mobile", "min": 22, "max": 44, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_script_size", "label": "Taille manuscrite mobile", "min": 28, "max": 58, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "mobile_card_width", "label": "Largeur carte produit mobile", "min": 45, "max": 90, "step": 1, "unit": "%", "default": 62 },
    { "type": "range", "id": "mobile_side", "label": "Marges latérales mobile", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_top", "label": "Marge haute mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 35 },
    { "type": "range", "id": "mobile_bottom", "label": "Marge basse mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 45 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Carte produit",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit Shopify" },
        { "type": "image_picker", "id": "image", "label": "Image personnalisée (facultatif)" },
        { "type": "text", "id": "title", "label": "Titre personnalisé" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre (ex. 6 montres)" },
        { "type": "text", "id": "price_text", "label": "Prix personnalisé (facultatif)" },
        { "type": "url", "id": "link", "label": "Lien personnalisé (facultatif)" }
      ]
    }
  ],
  "max_blocks": 18,
  "presets": [
    {
      "name": "Favoris clients - Slider",
      "blocks": [
        { "type": "product_card", "settings": { "title": "BOÎTE OPÉRA", "subtitle": "6 montres", "price_text": "À partir de 134,99 €" } },
        { "type": "product_card", "settings": { "title": "REMONTOIR CASSIOPÉE", "subtitle": "4 montres", "price_text": "À partir de 264,99 €" } },
        { "type": "product_card", "settings": { "title": "ÉTUI TRAVERSÉE", "subtitle": "4 montres", "price_text": "À partir de 54,99 €" } }
      ]
    }
  ]
}
{% endschema %}