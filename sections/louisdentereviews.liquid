<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Luxurious+Script&display=swap" rel="stylesheet">

<section class="ld-reviews-hero" data-ld-reviews-section="{{ section.id }}" style="
  --ld-height: {{ section.settings.desktop_height }}px;
  --ld-height-mobile: {{ section.settings.mobile_height }}px;
  --ld-blur: {{ section.settings.background_blur }}px;
  --ld-position: {{ section.settings.background_position }};
  --ld-overlay: {{ section.settings.overlay_color }};
  --ld-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  --ld-title-color: {{ section.settings.title_color }};
  --ld-title-size: {{ section.settings.title_size }}px;
  --ld-script-size: {{ section.settings.script_size }}px;
  --ld-title-mobile: {{ section.settings.mobile_title_size }}px;
  --ld-script-mobile: {{ section.settings.mobile_script_size }}px;
  --ld-card-bg: {{ section.settings.card_background }};
  --ld-card-text: {{ section.settings.card_text_color }};
  --ld-card-muted: {{ section.settings.card_muted_color }};
  --ld-card-width: {{ section.settings.card_width }}px;
  --ld-card-padding: {{ section.settings.card_padding }}px;
  --ld-card-radius: {{ section.settings.card_radius }}px;
  --ld-quote-size: {{ section.settings.quote_size }}px;
  --ld-quote-mobile: {{ section.settings.mobile_quote_size }}px;
  --ld-stars-color: {{ section.settings.stars_color }};
  --ld-top: {{ section.settings.padding_top }}px;
  --ld-bottom: {{ section.settings.padding_bottom }}px;
  --ld-top-mobile: {{ section.settings.mobile_padding_top }}px;
  --ld-bottom-mobile: {{ section.settings.mobile_padding_bottom }}px;
">
  <div class="ld-reviews-hero__background" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      <picture>
        {% if section.settings.mobile_background_image != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_background_image | image_url: width: 1100 }}">
        {% endif %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'ld-reviews-hero__background-image', loading: 'eager', fetchpriority: 'high', alt: '' }}
      </picture>
    {% endif %}
  </div>
  <div class="ld-reviews-hero__overlay" aria-hidden="true"></div>

  <div class="ld-reviews-hero__inner">
    {% if section.settings.eyebrow != blank or section.settings.show_top_stars %}
      <div class="ld-reviews-hero__eyebrow">
        {% if section.settings.show_top_stars %}
          <span class="ld-reviews-hero__top-stars" aria-label="Five stars">★★★★★</span>
        {% endif %}
        {% if section.settings.eyebrow != blank %}
          <span>{{ section.settings.eyebrow | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    <h2 class="ld-reviews-hero__heading">
      <span>{{ section.settings.title | escape }}</span>
      {% if section.settings.script_title != blank %}
        <span class="ld-reviews-hero__script">{{ section.settings.script_title | escape }}</span>
      {% endif %}
    </h2>

    <div class="ld-reviews-hero__carousel" data-ld-review-carousel>
      <div class="ld-reviews-hero__slides" aria-live="polite">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            {% assign linked_product = block.settings.product %}
            {% assign linked_image = block.settings.product_image %}
            {% if linked_image == blank and linked_product != blank %}
              {% assign linked_image = linked_product.featured_image %}
            {% endif %}
            {% assign linked_title = block.settings.product_title %}
            {% if linked_title == blank and linked_product != blank %}
              {% assign linked_title = linked_product.title %}
            {% endif %}
            {% assign linked_url = block.settings.product_link %}
            {% if linked_url == blank and linked_product != blank %}
              {% assign linked_url = linked_product.url %}
            {% endif %}

            <article class="ld-reviews-hero__card" data-ld-review-slide {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="ld-reviews-hero__review-heading">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.quote != blank %}
                <blockquote class="ld-reviews-hero__quote">“{{ block.settings.quote | escape | newline_to_br }}”</blockquote>
              {% endif %}
              <div class="ld-reviews-hero__review-bottom">
                {% if block.settings.author != blank %}
                  <p class="ld-reviews-hero__author">
                    {{ block.settings.author | escape }}
                    {% if block.settings.verified %}<span> · Verified purchase</span>{% endif %}
                  </p>
                {% endif %}
                {% if section.settings.show_review_stars %}
                  <div class="ld-reviews-hero__review-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {% assign review_rating = block.settings.rating | plus: 0 %}
                    {% for star_index in (1..5) %}
                      {% if star_index <= review_rating %}★{% else %}☆{% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                {% if linked_title != blank or linked_image != blank %}
                  <div class="ld-reviews-hero__product">
                    {% if linked_image != blank %}
                      {{ linked_image | image_url: width: 130 | image_tag: class: 'ld-reviews-hero__product-image', loading: 'lazy', alt: '' }}
                    {% endif %}
                    <div class="ld-reviews-hero__product-text">
                      {% if linked_title != blank %}<span>{{ linked_title | escape }}</span>{% endif %}
                      {% if linked_url != blank %}<span class="ld-reviews-hero__discover">Discover</span>{% endif %}
                    </div>
                    {% if linked_url != blank %}
                      <a class="ld-reviews-hero__product-link" href="{{ linked_url }}" aria-label="Discover {{ linked_title | escape }}"></a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="ld-reviews-hero__navigation">
          <button type="button" data-ld-review-prev aria-label="Previous customer review">←</button>
          <span data-ld-review-count>1 / {{ section.blocks.size }}</span>
          <button type="button" data-ld-review-next aria-label="Next customer review">→</button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ld-reviews-hero { position: relative; isolation: isolate; display: flex; justify-content: center; align-items: center; width: 100%; min-height: var(--ld-height); padding: var(--ld-top) 24px var(--ld-bottom); box-sizing: border-box; overflow: hidden; color: var(--ld-title-color); background: #5b4538; }
  .ld-reviews-hero *, .ld-reviews-hero *::before, .ld-reviews-hero *::after { box-sizing: border-box; }
  .ld-reviews-hero__background, .ld-reviews-hero__background picture, .ld-reviews-hero__overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ld-reviews-hero__background { z-index: -2; background: linear-gradient(110deg, #a28e79, #4c3026 60%, #221b17); }
  .ld-reviews-hero__background-image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--ld-position); filter: blur(var(--ld-blur)); transform: scale(1.06); }
  .ld-reviews-hero__overlay { z-index: -1; background: var(--ld-overlay); opacity: var(--ld-overlay-opacity); }
  .ld-reviews-hero__inner { position: relative; width: 100%; max-width: 1100px; text-align: center; }
  .ld-reviews-hero__eyebrow { font-family: var(--font-body-family, inherit); display: flex; align-items: center; justify-content: center; gap: 9px; font-size: 11px; line-height: 1.5; color: var(--ld-title-color); margin-bottom: 14px; }
  .ld-reviews-hero__top-stars { font-size: 12px; letter-spacing: .1em; color: var(--ld-title-color); }
  .ld-reviews-hero__heading { font-family: var(--font-heading-family, var(--font-body-family, inherit)); margin: 0 0 26px; font-size: var(--ld-title-size); font-weight: 400; line-height: 1.2; letter-spacing: -.035em; color: var(--ld-title-color); }
  .ld-reviews-hero__script { font-family: 'Luxurious Script', cursive; font-size: var(--ld-script-size); font-style: italic; font-weight: 400; line-height: 1; letter-spacing: 0; white-space: nowrap; }
  .ld-reviews-hero__carousel { margin: 0 auto; width: 100%; max-width: var(--ld-card-width); }
  .ld-reviews-hero__card { display: flex; flex-direction: column; justify-content: space-between; width: 100%; min-height: 335px; padding: var(--ld-card-padding); border-radius: var(--ld-card-radius); background: var(--ld-card-bg); color: var(--ld-card-text); text-align: center; }
  .ld-reviews-hero__card[hidden] { display: none; }
  .ld-reviews-hero__review-heading { color: var(--ld-card-text); font-family: var(--font-body-family, inherit); font-size: 11px; font-weight: 600; line-height: 1.4; margin: 0 0 12px; }
  .ld-reviews-hero__quote { font-family: var(--font-body-family, inherit); font-size: var(--ld-quote-size); font-weight: 400; line-height: 1.5; color: var(--ld-card-text); margin: 0 auto 22px; max-width: 440px; }
  .ld-reviews-hero__review-bottom { margin-top: auto; }
  .ld-reviews-hero__author { font-family: var(--font-body-family, inherit); font-size: 11px; font-weight: 600; color: var(--ld-card-text); line-height: 1.5; margin: 0 0 6px; }
  .ld-reviews-hero__author span { font-weight: 400; color: var(--ld-card-muted); }
  .ld-reviews-hero__review-stars { color: var(--ld-stars-color); font-size: 12px; line-height: 1.4; letter-spacing: .09em; }
  .ld-reviews-hero__product { display: flex; align-items: center; justify-content: center; position: relative; gap: 10px; width: fit-content; max-width: 100%; text-align: left; margin: 15px auto 0; }
  .ld-reviews-hero__product-image { display: block; width: 38px; height: 38px; object-fit: cover; border-radius: 4px; }
  .ld-reviews-hero__product-text { display: flex; gap: 4px; flex-wrap: wrap; align-items: baseline; font-family: var(--font-body-family, inherit); color: var(--ld-card-text); font-size: 11px; }
  .ld-reviews-hero__discover { text-decoration: underline; text-underline-offset: 3px; }
  .ld-reviews-hero__product-link { position: absolute; inset: 0; }
  .ld-reviews-hero__navigation { display: flex; align-items: center; justify-content: center; gap: 18px; margin: 14px auto 0; font-family: var(--font-body-family, inherit); color: var(--ld-title-color); font-size: 12px; }
  .ld-reviews-hero__navigation button { border: 1px solid currentColor; color: inherit; background: transparent; border-radius: 50%; width: 30px; height: 30px; font-size: 16px; cursor: pointer; }
  .ld-reviews-hero__navigation button:hover { background: rgba(255,255,255,.1); }
  .ld-reviews-hero button:focus-visible, .ld-reviews-hero__product-link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ld-reviews-hero { min-height: var(--ld-height-mobile); padding: var(--ld-top-mobile) 18px var(--ld-bottom-mobile); }
    .ld-reviews-hero__heading { font-size: var(--ld-title-mobile); margin-bottom: 24px; }
    .ld-reviews-hero__script { font-size: var(--ld-script-mobile); }
    .ld-reviews-hero__eyebrow { font-size: 10px; flex-wrap: wrap; }
    .ld-reviews-hero__card { min-height: 315px; padding: 28px 24px; }
    .ld-reviews-hero__quote { font-size: var(--ld-quote-mobile); line-height: 1.55; }
  }
  @media screen and (max-width: 390px) {
    .ld-reviews-hero__heading span:first-child { display: block; }
    .ld-reviews-hero__script { white-space: normal; }
    .ld-reviews-hero__card { padding: 25px 19px; }
  }
{% endstylesheet %}

{% javascript %}
  function initLouisDanteReviews(root) {
    root.querySelectorAll('[data-ld-review-carousel]').forEach(function(carousel) {
      if (carousel.dataset.ready === 'true') return;
      carousel.dataset.ready = 'true';
      var slides = Array.from(carousel.querySelectorAll('[data-ld-review-slide]'));
      var previous = carousel.querySelector('[data-ld-review-prev]');
      var next = carousel.querySelector('[data-ld-review-next]');
      var counter = carousel.querySelector('[data-ld-review-count]');
      var index = 0;
      if (slides.length < 2) return;
      function showSlide(newIndex) {
        index = (newIndex + slides.length) % slides.length;
        slides.forEach(function(slide, i) { slide.hidden = i !== index; });
        if (counter) counter.textContent = (index + 1) + ' / ' + slides.length;
      }
      if (previous) previous.addEventListener('click', function() { showSlide(index - 1); });
      if (next) next.addEventListener('click', function() { showSlide(index + 1); });
    });
  }
  initLouisDanteReviews(document);
  document.addEventListener('shopify:section:load', function(event) { initLouisDanteReviews(event.target); });
{% endjavascript %}

{% schema %}
{
  "name": "Louis Dante - Reviews",
  "tag": "section",
  "class": "section-louis-dante-reviews",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Desktop background image" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Mobile background image (optional)" },
    { "type": "select", "id": "background_position", "label": "Image position", "options": [
      { "value": "center center", "label": "Centre" },
      { "value": "center top", "label": "Haut" },
      { "value": "center bottom", "label": "Bas" },
      { "value": "left center", "label": "Gauche" },
      { "value": "right center", "label": "Droite" }
    ], "default": "center center" },
    { "type": "range", "id": "background_blur", "label": "Background blur", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 4 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#2B211B" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "THE LOUIS DANTE EXPERIENCE" },
    { "type": "checkbox", "id": "show_top_stars", "label": "Display 5 stars above the title", "default": false },
    { "type": "text", "id": "title", "label": "Main heading", "default": "They chose" },
    { "type": "text", "id": "script_title", "label": "Luxurious Script text", "default": "Louis Dante." },
    { "type": "color", "id": "title_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "range", "id": "title_size", "label": "Desktop heading size", "min": 25, "max": 65, "step": 1, "unit": "px", "default": 43 },
    { "type": "range", "id": "script_size", "label": "Desktop script size", "min": 35, "max": 85, "step": 1, "unit": "px", "default": 60 },
    { "type": "header", "content": "Review card" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F5F1EC" },
    { "type": "color", "id": "card_text_color", "label": "Review text color", "default": "#17283A" },
    { "type": "color", "id": "card_muted_color", "label": "Secondary text color", "default": "#6E7480" },
    { "type": "color", "id": "stars_color", "label": "Star color", "default": "#AD8C62" },
    { "type": "checkbox", "id": "show_review_stars", "label": "Show rating for each review", "default": false },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 350, "max": 700, "step": 10, "unit": "px", "default": 500 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "card_radius", "label": "Rounded corners", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 5 },
    { "type": "range", "id": "quote_size", "label": "Review text size", "min": 14, "max": 25, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "desktop_height", "label": "Minimum height", "min": 450, "max": 850, "step": 10, "unit": "px", "default": 590 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 5, "unit": "px", "default": 75 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 5, "unit": "px", "default": 75 },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 450, "max": 850, "step": 10, "unit": "px", "default": 620 },
    { "type": "range", "id": "mobile_title_size", "label": "Mobile heading size", "min": 24, "max": 45, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_script_size", "label": "Mobile script size", "min": 30, "max": 65, "step": 1, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_quote_size", "label": "Mobile review text size", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 20, "max": 120, "step": 5, "unit": "px", "default": 55 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 20, "max": 120, "step": 5, "unit": "px", "default": 55 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "text", "id": "heading", "label": "Review title", "default": "A wonderful surprise" },
        { "type": "textarea", "id": "quote", "label": "Genuine customer review", "default": "Add a genuine customer review here. Share what they loved about their Louis Dante piece." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase (only if confirmed)", "default": false },
        { "type": "select", "id": "rating", "label": "Review rating", "options": [
          { "value": "5", "label": "5 stars" },
          { "value": "4", "label": "4 stars" },
          { "value": "3", "label": "3 stars" },
          { "value": "2", "label": "2 stars" },
          { "value": "1", "label": "1 star" }
        ], "default": "5" },
        { "type": "product", "id": "product", "label": "Linked product" },
        { "type": "image_picker", "id": "product_image", "label": "Custom product image (optional)" },
        { "type": "text", "id": "product_title", "label": "Custom product title" },
        { "type": "url", "id": "product_link", "label": "Custom product link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Louis Dante - Reviews",
      "blocks": [
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}