{% liquid
  assign ld_main_image = section.settings.image_desktop | default: section.settings.image_mobile
%}

<section
  id="ld-image-card-{{ section.id }}"
  class="ld-image-card{% if section.settings.reverse_desktop %} ld-image-card--reverse{% endif %}{% if section.settings.text_alignment == 'left' %} ld-image-card--left{% endif %}"
  style="
    --ld-bg: {{ section.settings.background_color }};
    --ld-card-bg: {{ section.settings.card_background }};
    --ld-title-color: {{ section.settings.title_color }};
    --ld-text-color: {{ section.settings.text_color }};
    --ld-icon-color: {{ section.settings.icon_color }};
    --ld-width: {{ section.settings.max_width }}px;
    --ld-image-width: {{ section.settings.image_width }}%;
    --ld-image-height: {{ section.settings.image_height_desktop }}px;
    --ld-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --ld-image-radius: {{ section.settings.image_radius }}px;
    --ld-gutter: {{ section.settings.side_padding }}px;
    --ld-card-width: {{ section.settings.card_width }}px;
    --ld-card-padding: {{ section.settings.card_padding_desktop }}px;
    --ld-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --ld-mobile-overlap: {{ section.settings.mobile_overlap }}px;
    --ld-title-size: {{ section.settings.title_size_desktop }}px;
    --ld-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --ld-body-size: {{ section.settings.body_size_desktop }}px;
    --ld-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --ld-top-padding: {{ section.settings.padding_top }}px;
    --ld-bottom-padding: {{ section.settings.padding_bottom }}px;
    --ld-object-position: {{ section.settings.image_position }};
  "
>
  <div class="ld-image-card__inner">
    <div class="ld-image-card__media">
      {% if ld_main_image != blank %}
        <picture>
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.image_mobile | image_url: width: 400 }} 400w,
                {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
                {{ section.settings.image_mobile | image_url: width: 900 }} 900w
              "
              sizes="100vw"
            >
          {% endif %}
          {{ ld_main_image | image_url: width: 1600 | image_tag: class: 'ld-image-card__image', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(max-width: 749px) 100vw, 55vw' }}
        </picture>
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ld-image-card__image ld-image-card__placeholder' }}
      {% endif %}
    </div>

    <div class="ld-image-card__card">
      {% if section.settings.heading != blank %}
        <h2 class="ld-image-card__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ld-image-card__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="ld-image-card__features">
          {% for block in section.blocks %}
            <div class="ld-image-card__feature" {{ block.shopify_attributes }}>
              {% if block.settings.custom_icon != blank %}
                {{ block.settings.custom_icon | image_url: width: 96 | image_tag: class: 'ld-image-card__icon ld-image-card__icon--image', loading: 'lazy', alt: '' }}
              {% elsif block.settings.icon != 'none' %}
                <span class="ld-image-card__icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'slide' %}
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 6h18v36H15z"/>
                        <path d="M11 10v28m26-28v28M19 9h10M19 39h10"/>
                        <path d="M13 14h3m-3 20h3m19-20h-3m3 20h-3"/>
                      </svg>
                    {% when 'waves' %}
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <path d="M4 12c7 4 13-4 20 0s13-4 20 0"/>
                        <path d="M4 20c7 4 13-4 20 0s13-4 20 0"/>
                        <path d="M4 28c7 4 13-4 20 0s13-4 20 0"/>
                        <path d="M4 36c7 4 13-4 20 0s13-4 20 0"/>
                      </svg>
                    {% when 'shield' %}
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M24 5 39 11v12c0 10-6 16-15 20C15 39 9 33 9 23V11z"/>
                        <path d="m17 24 5 5 10-11"/>
                      </svg>
                    {% when 'check' %}
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="24" cy="24" r="18"/>
                        <path d="m15 24 6 6 12-13"/>
                      </svg>
                  {% endcase %}
                </span>
              {% endif %}

              {% if block.settings.label != blank %}
                <span class="ld-image-card__feature-label">{{ block.settings.label | escape }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ld-image-card {
    width: 100%;
    padding: var(--ld-top-padding) 0 var(--ld-bottom-padding);
    background: var(--ld-bg);
    color: var(--ld-text-color);
    font-family: var(--text-font-family, var(--font-body-family, inherit));
  }

  .ld-image-card *,
  .ld-image-card *::before,
  .ld-image-card *::after { box-sizing: border-box; }

  .ld-image-card__inner {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    max-width: var(--ld-width);
    min-height: var(--ld-image-height);
    padding: 0 var(--ld-gutter);
    margin: 0 auto;
  }

  .ld-image-card__media {
    position: relative;
    width: var(--ld-image-width);
    height: var(--ld-image-height);
    margin-left: auto;
    border-radius: var(--ld-image-radius);
    overflow: hidden;
    background: #eae6e1;
  }

  .ld-image-card__media picture,
  .ld-image-card__image,
  .ld-image-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ld-image-card__image {
    object-fit: cover;
    object-position: var(--ld-object-position);
  }

  .ld-image-card__placeholder { fill: #c7bcb0; }

  .ld-image-card__card {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: var(--ld-gutter);
    width: min(var(--ld-card-width), 62%);
    padding: var(--ld-card-padding);
    transform: translateY(-50%);
    text-align: center;
    background: var(--ld-card-bg);
    box-shadow: 0 5px 18px rgb(0 0 0 / 7%);
  }

  .ld-image-card__heading {
    margin: 0 0 16px;
    color: var(--ld-title-color);
    font-family: var(--heading-font-family, var(--font-heading-family, inherit));
    font-size: var(--ld-title-size);
    font-weight: var(--heading-font-weight, var(--font-heading-weight, 700));
    line-height: 1.2;
    letter-spacing: -.02em;
    text-transform: none;
  }

  .ld-image-card__description {
    margin: 0;
    color: var(--ld-text-color);
    font-family: inherit;
    font-size: var(--ld-body-size);
    font-weight: 400;
    line-height: 1.7;
  }

  .ld-image-card__description p { margin: 0 0 10px; }
  .ld-image-card__description p:last-child { margin-bottom: 0; }

  .ld-image-card__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 22px 20px;
    margin-top: 34px;
  }

  .ld-image-card__feature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    color: var(--ld-text-color);
  }

  .ld-image-card__icon {
    display: flex;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    color: var(--ld-icon-color);
  }

  .ld-image-card__icon svg,
  .ld-image-card__icon--image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ld-image-card__feature-label {
    min-width: 0;
    font-size: 14px;
    line-height: 1.4;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .ld-image-card--left .ld-image-card__card { text-align: left; }
  .ld-image-card--left .ld-image-card__feature { justify-content: flex-start; }

  .ld-image-card--reverse .ld-image-card__media {
    margin-left: 0;
    margin-right: auto;
  }

  .ld-image-card--reverse .ld-image-card__card {
    left: auto;
    right: var(--ld-gutter);
  }

  @media screen and (max-width: 749px) {
    .ld-image-card {
      padding: 0 0 var(--ld-bottom-padding);
    }

    .ld-image-card__inner {
      display: block;
      min-height: 0;
      padding: 0;
    }

    .ld-image-card__media,
    .ld-image-card--reverse .ld-image-card__media {
      width: 100%;
      height: var(--ld-image-height-mobile);
      margin: 0;
      border-radius: 0;
    }

    .ld-image-card__card,
    .ld-image-card--reverse .ld-image-card__card {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      width: calc(100% - 32px);
      margin: calc(-1 * var(--ld-mobile-overlap)) auto 0;
      padding: var(--ld-card-padding-mobile);
      transform: none;
    }

    .ld-image-card__heading {
      margin-bottom: 14px;
      font-size: var(--ld-title-size-mobile);
    }

    .ld-image-card__description {
      font-size: var(--ld-body-size-mobile);
      line-height: 1.65;
    }

    .ld-image-card__features {
      gap: 16px 12px;
      margin-top: 26px;
    }

    .ld-image-card__feature { gap: 8px; }
    .ld-image-card__icon { flex-basis: 33px; width: 33px; height: 33px; }
    .ld-image-card__feature-label { font-size: 12px; line-height: 1.35; }
  }

  @media screen and (max-width: 359px) {
    .ld-image-card__card { width: calc(100% - 24px); }
    .ld-image-card__feature { gap: 6px; }
    .ld-image-card__icon { flex-basis: 27px; width: 27px; height: 27px; }
    .ld-image-card__feature-label { font-size: 11px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LD Image + Floating Card",
  "tag": "section",
  "class": "ld-floating-feature-section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "select", "id": "image_position", "label": "Image focal point", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ], "default": "center center" },
    { "type": "range", "id": "image_height_desktop", "label": "Desktop image height", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 660 },
    { "type": "range", "id": "image_height_mobile", "label": "Mobile image height", "min": 250, "max": 750, "step": 10, "unit": "px", "default": 440 },
    { "type": "range", "id": "image_width", "label": "Desktop image width", "min": 45, "max": 70, "step": 1, "unit": "%", "default": 55 },
    { "type": "range", "id": "image_radius", "label": "Desktop image corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },

    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sliding System" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Every watch roll features soft velvet and flexible M-shaped cushions with slide-in rails for secure storage. Designed to fit all wrist sizes.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "range", "id": "title_size_desktop", "label": "Heading size PC", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "title_size_mobile", "label": "Heading size mobile", "min": 18, "max": 36, "step": 1, "unit": "px", "default": 25 },
    { "type": "range", "id": "body_size_desktop", "label": "Body size PC", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_size_mobile", "label": "Body size mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Layout and spacing" },
    { "type": "checkbox", "id": "reverse_desktop", "label": "Image on left (PC)", "default": false },
    { "type": "range", "id": "max_width", "label": "Maximum section width", "min": 1000, "max": 1800, "step": 50, "unit": "px", "default": 1500 },
    { "type": "range", "id": "side_padding", "label": "PC horizontal padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "card_width", "label": "Card width PC", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "card_padding_desktop", "label": "Card inner padding PC", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 55 },
    { "type": "range", "id": "card_padding_mobile", "label": "Card inner padding mobile", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_overlap", "label": "Card overlap on mobile", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_top", "label": "Top spacing PC", "min": 0, "max": 160, "step": 10, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 10, "unit": "px", "default": 30 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_background", "label": "Text card background", "default": "#F1F1F1" },
    { "type": "color", "id": "title_color", "label": "Heading color", "default": "#1C2A36" },
    { "type": "color", "id": "text_color", "label": "Body and feature text color", "default": "#3D4348" },
    { "type": "color", "id": "icon_color", "label": "Feature icon color", "default": "#CDB9A5" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature icon + text",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature text", "default": "Sliding Cushion" },
        { "type": "select", "id": "icon", "label": "Built-in icon", "options": [
          { "value": "slide", "label": "Sliding cushion" },
          { "value": "waves", "label": "Soft waves" },
          { "value": "shield", "label": "Protection" },
          { "value": "check", "label": "Check" },
          { "value": "none", "label": "No icon" }
        ], "default": "slide" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (overrides built-in)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "LD Image + Floating Card",
      "blocks": [
        { "type": "feature", "settings": { "label": "Sliding Cushion", "icon": "slide" } },
        { "type": "feature", "settings": { "label": "Soft & Flexible Cushion", "icon": "waves" } }
      ]
    }
  ]
}
{% endschema %}